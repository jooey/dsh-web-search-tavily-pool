{
  "name": "dsh-web-search-tavily-pool",
  "version": "1.3.0",
  "description": "DSH web plugin: tavily search provider for ctx.web with a managed multi-key pool (per-key add/remove/enable/test from Settings), rotation, cooldown, and quota-aware failover",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "jooey",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "tavily",
    "web-search",
    "plugin"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "install.sh",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.7"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jooey/dsh-web-search-tavily-pool.git"
  }
}
